<?xml version="1.0" encoding="utf-8"?>
<!-- android/app/src/main/res/xml/data_extraction_rules.xml -->
<!-- Exclude SQLite DB from cloud backup (privacy) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="idea_manager.db" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
